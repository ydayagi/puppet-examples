Puppet::Functions.create_function(:myFunction1) do
  dispatch :execute do
    param 'String', :url
    return_type 'Variant[Hash, Array, String]'
  end

  def execute(url)
    uri = URI.parse(url)
    response = Net::HTTP.get_response(uri)

    if response.is_a?(Net::HTTPSuccess)
      begin
        JSON.parse(response.body)
      rescue JSON::ParserError
