# Redis configuration — Managed by Ansible
# Node: {{ ansible_fqdn }}

bind 0.0.0.0
port {{ redis_cluster_case2_redis_port }}
daemonize yes
pidfile /var/run/redis/redis-server.pid
logfile {{ redis_cluster_case2_log_dir }}/redis-server.log
loglevel notice

# Security
requirepass {{ redis_password }}

# Persistence
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# RDB snapshots
save 900 1
save 300 10
save 60 10000
dbfilename dump.rdb
dir {{ redis_cluster_case2_data_dir }}

# Memory
maxmemory {{ redis_cluster_case2_maxmemory_mb }}mb
maxmemory-policy {{ redis_cluster_case2_maxmemory_policy }}

# Network
tcp-backlog 511
timeout 0
tcp-keepalive 300
